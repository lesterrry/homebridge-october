{
  "displayName": "Homebridge October Heater Plugin",
  "name": "homebridge-october",
  "private": true,
  "version": "1.0.0",
  "description": "Plugin for personal use",
  "license": "MIT",
  "homepage": "https://github.com/lesterrry/homebridge-october",
  "repository": {
    "type": "git",
    "url": "https://github.com/lesterrry/homebridge-october"
  },
  "bugs": {
    "url": "https://github.com/lesterrry/homebridge-october/issues"
  },
  "author": "lesterrry",
  "engines": {
    "node": ">=22.0.0",
    "homebridge": ">=1.9.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "format": "biome format . --write",
    "watch": "npm run build && npm link --registry https://registry.npmjs.org && nodemon"
  },
  "keywords": [
    "homebridge-plugin",
    "aqara",
    "ir",
    "ac"
  ],
  "dependencies": {
    "axios": "^0.21.4",
    "homebridge-lib": "^7.1.5",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^12.20.55",
    "homebridge": "1.9.0",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-node": "^9.1.1",
    "typescript": "^4.9.5"
  }
}
