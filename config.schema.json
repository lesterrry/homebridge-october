{
  "pluginAlias": "October",
  "pluginType": "platform",
  "headerDisplay": "USB Serial thermostat October",
  "singular": true,
  "customUi": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "October"
      },
      "commandPath": {
        "title": "Path to the October executable",
        "type": "string",
        "minLength": 1,
        "default": "/home/volchok/bin/october"
      },
      "pollInterval": {
        "title": "Polling interval (seconds)",
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 30
      },
      "commandTimeout": {
        "title": "Command timeout (milliseconds)",
        "type": "integer",
        "minimum": 100,
        "maximum": 60000,
        "default": 2000
      }
    }
  }
}
