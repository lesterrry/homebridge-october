{
  "displayName": "Homebridge October Heater Plugin",
  "name": "homebridge-october",
  "version": "2.0.0",
  "description": "A simple plugin that exposes Aqara Ir AC control as a Thermostat",
  "license": "MIT",
  "homepage": "https://github.com/lesterrry/Homebridge-Aqara-IR-Controller",
  "repository": {
    "type": "git",
    "url": "https://github.com/lesterrry/Homebridge-Aqara-IR-Controller.git"
  },
  "bugs": {
    "url": "https://github.com/lesterrry/Homebridge-Aqara-IR-Controller/issues"
  },
  "author": "lesterrry",
  "engines": {
    "node": ">=10.17.0",
    "homebridge": ">=1.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link --registry https://registry.npmjs.org && nodemon"
  },
  "keywords": [
    "homebridge-plugin",
    "aqara",
    "ir",
    "ac"
  ],
  "dependencies": {
    "axios": "^0.21.4",
    "homebridge-lib": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@types/node": "^12.20.55",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "eslint": "^8.56.0",
    "homebridge": "1.3.0",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-node": "^9.1.1",
    "typescript": "^4.9.5"
  }
}
